#!/bin/sh
# Block pushes to main on the remote. main only changes through pull requests merged on GitHub.
# git passes one line per ref: <local ref> <local sha> <remote ref> <remote sha>
while read -r local_ref local_sha remote_ref remote_sha; do
    case "$remote_ref" in
        refs/heads/main|refs/heads/master)
            echo "" >&2
            echo "  Blocked: don't push directly to '${remote_ref#refs/heads/}'." >&2
            echo "  Push your branch instead and open a pull request:" >&2
            echo "      git push -u origin HEAD" >&2
            echo "      gh pr create --fill --base main" >&2
            echo "" >&2
            exit 1
            ;;
    esac
done
exit 0
